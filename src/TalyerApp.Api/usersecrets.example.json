{
  "Bootstrap": {
    "PlatformAdmin": {
      "ProviderUserId": "<sub-keycloak>",
      "Email": "",
      "Username": "",
      "FirstName": "",
      "LastName": "",
      "Provider": "keycloak"
    }
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:8080",
    "Realm": "talyer-realm",
    "Admin": {
      "ClientId": "talyer-api-admin",
      "ClientSecret": ""
    },
    "Api": {
      "Audience": "talyer-api",
      "RequireHttpsMetadata": false
    },
    "Docs": {
      "ScalarRoute": "/talyer-app-api",
      "OAuthClientId": "talyer-api-docs",
      "OAuthScopes": [ "openid", "profile", "email" ]
    }
  },
  "Membership": {
    "ConfirmEmailBaseUrl": "http://localhost:5066"
  }
}
